# ==========================================
# AutoCUB API - Configuração de Ambiente
# Mimetizado do padrão autoSINAPI / Mundo AEC
# ==========================================

# Ambiente da Aplicação
ENVIRONMENT=development
LOG_LEVEL=INFO

# Banco de Dados PostgreSQL
POSTGRES_USER=autocub_user
POSTGRES_PASSWORD=autocub_pass
POSTGRES_DB=cub
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Kong Gateway Database (para ambiente Docker Compose)
KONG_PG_USER=kong
KONG_PG_PASSWORD=kong_pass

# Redis (Celery Broker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# API Settings
API_HOST=0.0.0.0
API_PORT=8002
API_PREFIX=/v1
SECRET_KEY=cub_secret_token_change_in_production

# Coleta Ética e Caching (cub.org.br)
CUB_BASE_URL=http://www.cub.org.br
CUB_REQUEST_DELAY_SECONDS=3.0
CUB_DOWNLOAD_DIR=autocub_downloads
